# PetMate 环境变量配置

# ============ 腾讯混元AI ============
TENCENT_CODING_TOKEN=your_token_here
BASE_URL=https://api.lkeap.cloud.tencent.com/coding/v3

# ============ Supabase数据库（可选，不配置则使用本地存储）============
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# ============ 微信支付（可选）============
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_NOTIFY_URL=

# ============ 应用配置 ============
NEXT_PUBLIC_APP_URL=https://petmate-beige.vercel.app
NEXT_PUBLIC_APP_NAME=宠伴PetMate

# ============ 分析工具（可选）============
NEXT_PUBLIC_GA_ID=
SENTRY_DSN=
